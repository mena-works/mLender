{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "2.74.0",
	"FriendlyName": "mLender",
	"Description": "Receives a Maya scene package over LiveLink and rebuilds it in Unreal: meshes with their hierarchy, materials as Material Instances, lights, cine cameras, and a simulation's rigid movers on a single motion player actor.",
	"Category": "Importers",
	"CreatedBy": "mena-works",
	"CreatedByURL": "https://github.com/mena-works/mLender",
	"DocsURL": "https://github.com/mena-works/mLender#unreal",
	"EnabledByDefault": true,
	"CanContainContent": true,
	"IsBetaVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "mLender",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "PythonScriptPlugin",
			"Enabled": true
		},
		{
			"Name": "InterchangeEditor",
			"Enabled": true
		}
	]
}
